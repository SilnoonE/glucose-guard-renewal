<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. Force Light Mode colors everywhere -->
    <style name="Base.Theme.Tenthapp" parent="Theme.Material3.Light.NoActionBar">
        <!-- 기본 색상 고정 -->
        <item name="colorPrimary">#2E7D32</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">#66BB6A</item>
        <item name="colorOnSecondary">#FFFFFF</item>

        <!-- Material3 필수 색상 고정 (BottomNavigationView 오류 방지) -->
        <item name="colorSurface">#FFFFFF</item>
        <item name="colorOnSurface">#1A1C19</item>
        <item name="colorSurfaceVariant">#F5F7F6</item>
        <item name="colorOnSurfaceVariant">#424940</item>
        <item name="colorSecondaryContainer">#E8F5E9</item>
        <item name="colorOnSecondaryContainer">#2E7D32</item>
        <item name="colorOutline">#DDE5DB</item>

        <item name="android:windowBackground">#F5F7F6</item>
        <item name="android:statusBarColor">#FFFFFF</item>
        <item name="android:windowLightStatusBar">true</item>

        <item name="toolbarStyle">@style/Widget.App.Toolbar</item>
        <item name="materialButtonStyle">@style/RoundedButton</item>
    </style>

    <style name="Widget.App.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="navigationIconTint">#FFFFFF</item>
        <item name="titleTextColor">#FFFFFF</item>
    </style>

    <style name="Theme.Tenthapp" parent="Base.Theme.Tenthapp" />

    <style name="AppToolbarTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>

    <style name="RoundedButton" parent="Widget.Material3.Button">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.App.SmallComponent</item>
        <item name="android:padding">12dp</item>
        <item name="backgroundTint">#2E7D32</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>

    <style name="ShapeAppearance.App.SmallComponent" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerSize">12dp</item>
    </style>

    <style name="CategoryChip" parent="Widget.Material3.Chip.Suggestion">
        <item name="android:textColor">#1A1C19</item>
        <item name="android:backgroundTint">#FFFFFF</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.App.SmallComponent</item>
    </style>
</resources>
