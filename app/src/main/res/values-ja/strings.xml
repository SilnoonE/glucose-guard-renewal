    <!-- Full Guide Keys -->
    <string name="guide_m_intro">血糖管理は代謝の健康を理解することです。</string>
    <string name="guide_m_s1_title">なぜ記録するのか</string>
    <string name="guide_m_s1_content">記録することでパターンと食事の影響を把握できます。</string>
    <string name="guide_m_s2_title">いつ測定するか</string>
    <string name="guide_m_s2_content">空腹時、食後2時間、就寝前などが基本です。</string>
    <string name="guide_m_s3_title">空腹時と食後の違い</string>
    <string name="guide_m_s3_content">両方の指標をバランスよく確認しましょう。</string>
    <string name="guide_m_s4_title">正確な測定方法</string>
    <string name="guide_m_s4_content">清潔な手で正しく測定してください。</string>
    <string name="guide_m_s5_title">変動要因</string>
    <string name="guide_m_s5_content">食事、運動、ストレスなどが影響します。</string>
    <string name="guide_m_s6_title">記録の確認方法</string>
    <string name="guide_m_s6_content">長期的なトレンドを確認しましょう。</string>
    <string name="guide_m_remember">継続的な管理が大切です。</string>
    <string name="guide_m_doctor">数値が高い場合は受診してください。</string>

    <string name="guide_e_title">運動のアドバイス</string>
    <string name="guide_e_intro">運動はインスリン感受性を高めます。</string>
    <string name="guide_e_s1_title">効果</string>
    <string name="guide_e_s1_content">血糖値を下げ、筋肉量を維持します。</string>
    <string name="guide_e_s2_title">ウォーキング</string>
    <string name="guide_e_s2_content">食後30分の散歩が効果的です。</string>
    <string name="guide_e_s3_title">自転車</string>
    <string name="guide_e_s3_content">関節への負担が少ない有酸素運動です。</string>
    <string name="guide_e_s4_title">水泳</string>
    <string name="guide_e_s4_content">全身運動で効果的です。</string>
    <string name="guide_e_s5_title">筋トレ</string>
    <string name="guide_e_s5_content">基礎代謝を高め、血糖を安定させます。</string>
    <string name="guide_e_s6_title">ストレッチ</string>
    <string name="guide_e_s6_content">柔軟性を維持しましょう。</string>
    <string name="guide_e_s7_title">事前確認</string>
    <string name="guide_e_s7_content">体調を確認してから始めましょう。</string>
    <string name="guide_e_s8_title">運動中低血糖</string>
    <string name="guide_e_s8_content">震えや冷や汗に注意してください。</string>
    <string name="guide_e_s9_title">中止すべき場合</string>
    <string name="guide_e_s9_content">体調不良時は無理をしないでください。</string>
    <string name="guide_e_remember">無理のない範囲で続けましょう。</string>

    <string name="guide_h_intro">高血糖は血管を傷つける可能性があります。</string>
    <string name="guide_h_s1_title">主要症状</string>
    <string name="guide_h_s1_content">喉の渇きや疲労感に注意しましょう。</string>
    <string name="guide_h_s2_title">原因</string>
    <string name="guide_h_s2_content">食事、薬の飲み忘れ、ストレスなど。</string>
    <string name="guide_h_s3_title">確認事項</string>
    <string name="guide_h_s3_content">再度正しく測定してください。</string>
    <string name="guide_h_s4_title">応急対応</string>
    <string name="guide_h_s4_content">水分を摂り、安静にしてください。</string>
    <string name="guide_h_s5_title">禁止事項</string>
    <string name="guide_h_s5_content">自己判断での増薬は危険です。</string>
    <string name="guide_h_s6_title">運動との関係</string>
    <string name="guide_h_s6_content">高すぎる時は運動を控えましょう。</string>
    <string name="guide_h_s7_title">緊急サイン</string>
    <string name="guide_h_s7_content">意識混濁はすぐに救급車を。</string>
    <string name="guide_h_s8_title">受診の目安</string>
    <string name="guide_h_s8_content">症状が改善しない場合は病院へ。</string>
    <string name="guide_h_warning">血管障害のリスクがあります。</string>
    <string name="guide_h_remember">原因の把握が第一歩です。</string>

    <string name="guide_l_intro">低血糖は迅速な対応が必要です。</string>
    <string name="guide_l_s1_title">初期症状</string>
    <string name="guide_l_s1_content">震えや強い空腹感。</string>
    <string name="guide_l_s2_title">進行症状</string>
    <string name="guide_l_s2_content">意識低下や混乱。</string>
    <string name="guide_l_s3_title">原因</string>
    <string name="guide_l_s3_content">空腹での運動、薬の過剰など。</string>
    <string name="guide_l_s4_title">15-15ルール</string>
    <string name="guide_l_s4_content">糖分15gを摂り、15分後に再測定。</string>
    <string name="guide_l_s5_title">不適当な食品</string>
    <string name="guide_l_s5_content">チョコやアイスは吸収が遅いです。</string>
    <string name="guide_l_s6_title">意識がない場合</string>
    <string name="guide_l_s6_content">口に何も入れず、すぐに119へ。</string>
    <string name="guide_l_s7_title">運転中</string>
    <string name="guide_l_s7_content">すぐに停車して対応してください。</string>
    <string name="guide_l_s8_title">運動後</string>
    <string name="guide_l_s8_content">数時間後も注意が必要です。</string>
    <string name="guide_l_s9_title">予防方法</string>
    <string name="guide_l_s9_content">補食を携帯しましょう。</string>
    <string name="guide_l_doctor">頻発する場合は相談しましょう。</string>
    <string name="guide_l_remember">待たずにすぐ糖分を。</string>

    <string name="guide_f_intro">健康的なバランス食が基本です。</string>
    <string name="guide_f_s1_title">糖質の選び方</string>
    <string name="guide_f_s1_content">食物繊維の多い穀物を選びましょう。</string>
    <string name="guide_f_s2_title">バランスの良い一皿</string>
    <string name="guide_f_s2_content">野菜1/2, タンパク1/4, 穀物1/4。</string>
    <string name="guide_f_s3_title">食べる順番</string>
    <string name="guide_f_s3_content">野菜から先に食べましょう。</string>
    <string name="guide_f_s4_title">推奨食品</string>
    <string name="guide_f_s4_content">青魚、豆腐、緑黄色野菜など。</string>
    <string name="guide_f_s5_title">控えたい食品</string>
    <string name="guide_f_s5_content">砂糖入りの飲料や菓子パン。</string>
    <string name="guide_f_s6_title">果物の摂り方</string>
    <string name="guide_f_s6_content">ジュースより生の果物を適量で。</string>
    <string name="guide_f_s7_title">GI値の理解</string>
    <string name="guide_f_s7_content">上昇速度を意識しましょう。</string>
    <string name="guide_f_s8_title">外食のコツ</string>
    <string name="guide_f_s8_content">揚げ物より焼き物を選びましょう。</string>
    <string name="guide_f_s9_title">間食の選び方</string>
    <string name="guide_f_s9_content">ナッツや無糖ヨーグルト。</string>
    <string name="guide_f_s10_title">飲み物と酒</string>
    <string name="guide_f_s10_content">お酒は空腹時を避けましょう。</string>
    <string name="guide_f_s11_title">食事記録</string>
    <string name="guide_f_s11_content">何を食べたか記録しましょう。</string>
    <string name="guide_f_remember">量が最も重要です。</string>

