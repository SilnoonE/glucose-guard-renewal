    <!-- Full Guide Keys -->
    <string name="guide_m_intro">Gestionar la glucosa es entender su salud metabólica.</string>
    <string name="guide_m_s1_title">¿Por qué registrar?</string>
    <string name="guide_m_s1_content">Para identificar patrones y el efecto de los alimentos.</string>
    <string name="guide_m_s2_title">¿Cuándo medir?</string>
    <string name="guide_m_s2_content">Mida en ayunas y dos horas después de comer.</string>
    <string name="guide_m_s3_title">Ayunas vs Post-comida</string>
    <string name="guide_m_s3_content">Ambos indicadores son vitales para el seguimiento.</string>
    <string name="guide_m_s4_title">Exactitud</string>
    <string name="guide_m_s4_content">Use manos limpias y tiras reactivas vigentes.</string>
    <string name="guide_m_s5_title">Fluctuaciones</string>
    <string name="guide_m_s5_content">Dieta, estrés y ejercicio afectan sus niveles.</string>
    <string name="guide_m_s6_title">Revisar registros</string>
    <string name="guide_m_s6_content">Busque tendencias a largo plazo en su historial.</string>
    <string name="guide_m_remember">La constancia es la base del éxito.</string>
    <string name="guide_m_doctor">Consulte si sus niveles son consistentemente altos.</string>

    <string name="guide_e_title">Consejos de Ejercicio</string>
    <string name="guide_e_intro">El ejercicio mejora la sensibilidad a la insulina.</string>
    <string name="guide_e_s1_title">Beneficios</string>
    <string name="guide_e_s1_content">Ayuda a estabilizar la glucosa y controlar el peso.</string>
    <string name="guide_e_s2_title">Caminata</string>
    <string name="guide_e_s2_content">Caminar 30 min después de comer es muy efectivo.</string>
    <string name="guide_e_s3_title">Ciclismo</string>
    <string name="guide_e_s3_content">Ideal para reducir el impacto en las articulaciones.</string>
    <string name="guide_e_s4_title">Natación</string>
    <string name="guide_e_s4_content">Un ejercicio aeróbico completo y seguro.</string>
    <string name="guide_e_s5_title">Fuerza</string>
    <string name="guide_e_s5_content">Mantenga su masa muscular para un mejor metabolismo.</string>
    <string name="guide_e_s6_title">Estiramientos</string>
    <string name="guide_e_s6_content">Mantenga la flexibilidad y evite lesiones.</string>
    <string name="guide_e_s7_title">Pre-chequeo</string>
    <string name="guide_e_s7_content">Verifique su estado físico antes de empezar.</string>
    <string name="guide_e_s8_title">Bajas durante ejercicio</string>
    <string name="guide_e_s8_content">Pare si siente mareo o sudor frío.</string>
    <string name="guide_e_s9_title">Cuándo parar</string>
    <string name="guide_e_s9_content">No se esfuerce si se siente mal de salud.</string>
    <string name="guide_e_remember">La regularidad es mejor que la intensidad.</string>

    <string name="guide_h_intro">La hiperglucemia prolongada puede dañar los vasos sanguíneos.</string>
    <string name="guide_h_s1_title">Síntomas</string>
    <string name="guide_h_s1_content">Esté atento a la sed excesiva y la fatiga.</string>
    <string name="guide_h_s2_title">Causas</string>
    <string name="guide_h_s2_content">Suele deberse a excesos en dieta o falta de medicación.</string>
    <string name="guide_h_s3_title">Verificación</string>
    <string name="guide_h_s3_content">Lave sus manos y vuelva a medir con cuidado.</string>
    <string name="guide_h_s4_title">Acciones</string>
    <string name="guide_h_s4_content">Hidrátese bien y mantenga reposo.</string>
    <string name="guide_h_s5_title">Lo que no debe hacer</string>
    <string name="guide_h_s5_content">No aumente su dosis de insulina sin permiso médico.</string>
    <string name="guide_h_s6_title">Sobre el ejercicio</string>
    <string name="guide_h_s6_content">Evite el ejercicio intenso si su glucosa es muy alta.</string>
    <string name="guide_h_s7_title">Emergencia</string>
    <string name="guide_h_s7_content">Confusión o vómitos requieren atención inmediata.</string>
    <string name="guide_h_s8_title">Cuándo ir al médico</string>
    <string name="guide_h_s8_content">Si los síntomas persisten o empeoran rápidamente.</string>
    <string name="guide_h_warning">El azúcar alto daña el sistema circulatorio.</string>
    <string name="guide_h_remember">Entender la causa es el primer paso para corregir.</string>

    <string name="guide_l_intro">La hipoglucemia requiere una respuesta inmediata.</string>
    <string name="guide_l_s1_title">Síntomas iniciales</string>
    <string name="guide_l_s1_content">Temblores, hambre extrema y sudoración.</string>
    <string name="guide_l_s2_title">Síntomas graves</string>
    <string name="guide_l_s2_content">Puede causar desorientación o pérdida de conciencia.</string>
    <string name="guide_l_s3_title">Causas comunes</string>
    <string name="guide_l_s3_content">Ejercicio en ayunas o exceso de medicación.</string>
    <string name="guide_l_s4_title">Regla 15-15</string>
    <string name="guide_l_s4_content">15g de carbs, espere 15 min y vuelva a medir.</string>
    <string name="guide_l_s5_title">No recomendado</string>
    <string name="guide_l_s5_content">Chocolates o helados son de absorción lenta.</string>
    <string name="guide_l_s6_title">Inconsciencia</string>
    <string name="guide_l_s6_content">No dé comida por la boca; llame a emergencias.</string>
    <string name="guide_l_s7_title">Conducción</string>
    <string name="guide_l_s7_content">Detenga el vehículo y trate la baja de inmediato.</string>
    <string name="guide_l_s8_title">Post-ejercicio</string>
    <string name="guide_l_s8_content">Vigile su azúcar horas después de entrenar.</string>
    <string name="guide_l_s9_title">Prevención</string>
    <string name="guide_l_s9_content">Lleve siempre consigo una fuente de azúcar rápido.</string>
    <string name="guide_l_doctor">Consulte si tiene bajas frecuentes.</string>
    <string name="guide_l_remember">Actúe rápido, no espere a que pase solo.</string>

    <string name="guide_f_intro">Una dieta equilibrada es la base de la salud.</string>
    <string name="guide_f_s1_title">Carbohidratos</string>
    <string name="guide_f_s1_content">Prefiera granos integrales en lugar de refinados.</string>
    <string name="guide_f_s2_title">Modelo de Plato</string>
    <string name="guide_f_s2_content">1/2 vegetales, 1/4 proteína, 1/4 granos.</string>
    <string name="guide_f_s3_title">Orden de comida</string>
    <string name="guide_f_s3_content">Coma primero la fibra para saciarse.</string>
    <string name="guide_f_s4_title">Recomendados</string>
    <string name="guide_f_s4_content">Pescado, tofu y vegetales de hoja verde.</string>
    <string name="guide_f_s5_title">Evite</string>
    <string name="guide_f_s5_content">Bebidas azucaradas y repostería industrial.</string>
    <string name="guide_f_s6_title">Frutas</string>
    <string name="guide_f_s6_content">Fruta fresca entera en porciones moderadas.</string>
    <string name="guide_f_s11_title">Registro de comidas</string>
    <string name="guide_f_s11_content">Anote lo que come para ver su reacción.</string>
    <string name="guide_f_remember">El control de las porciones es lo más importante.</string>

