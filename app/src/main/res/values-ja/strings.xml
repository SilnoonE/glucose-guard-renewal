    <string name="guide_target_item1">HbA1c: 6.5%未満推奨</string>
    <string name="guide_target_item2">空腹時: 70 ~ 130 mg/dL</string>
    <string name="guide_target_item3">食後: 180 mg/dL未満</string>
    <string name="guide_target_info">3ヶ月の平均指標を意識しましょう。</string>
