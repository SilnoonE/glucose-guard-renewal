    <string name="guide_target_subtitle">Targets vary per individual.</string>
    <string name="guide_target_item1">HbA1c: below 6.5%</string>
    <string name="guide_target_item2">Fasting: 70 ~ 130 mg/dL</string>
    <string name="guide_target_item3">2h Post-meal: below 180 mg/dL</string>
    <string name="guide_target_info">Manage your 3-month average glucose indicator.</string>
