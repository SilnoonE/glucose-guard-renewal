    <!-- Full Guide Keys -->
    <string name="guide_m_intro">血糖管理即是了解您的代谢健康状况。</string>
    <string name="guide_m_s1_title">为何记录？</string>
    <string name="guide_m_s1_content">记录可以帮助发现规律和饮食对身体的影响。</string>
    <string name="guide_m_s2_title">何时测量？</string>
    <string name="guide_m_s2_content">建议在空腹和餐后两小时进行测量。</string>
    <string name="guide_m_s3_title">空腹与餐后</string>
    <string name="guide_m_s3_content">两个指标对于代谢评估都非常重要。</string>
    <string name="guide_m_s4_title">准确测量</string>
    <string name="guide_m_s4_content">请确保双手清洁并检查试纸效期。</string>
    <string name="guide_m_s5_title">影响因素</string>
    <string name="guide_m_s5_content">饮食、运动和压力都会影响血糖水平。</string>
    <string name="guide_m_s6_title">查看记录</string>
    <string name="guide_m_s6_content">重点关注长期的血糖变化趋势。</string>
    <string name="guide_m_remember">持之以恒的监测至关重要。</string>
    <string name="guide_m_doctor">如数值持续偏高，请咨询医生。</string>

    <string name="guide_e_title">运动建议</string>
    <string name="guide_e_intro">运动有助于提高胰岛素敏感性。</string>
    <string name="guide_e_s1_title">好处</string>
    <string name="guide_e_s1_content">稳定血糖水平并帮助控制体重。</string>
    <string name="guide_e_s2_title">步行</string>
    <string name="guide_e_s2_content">餐后 30 分钟进行轻快步行非常有效。</string>
    <string name="guide_e_s3_title">骑行</string>
    <string name="guide_e_s3_content">低关节压力的有氧运动选择。</string>
    <string name="guide_e_s4_title">游泳</string>
    <string name="guide_e_s4_content">非常适合全身锻炼的有氧运动。</string>
    <string name="guide_e_s5_title">力量训练</string>
    <string name="guide_e_s5_content">通过维持肌肉量来促进基础代谢。</string>
    <string name="guide_e_s6_title">拉伸</string>
    <string name="guide_e_s6_content">保持关节灵活性并预防运动损伤。</string>
    <string name="guide_e_s7_title">前检查</string>
    <string name="guide_e_s7_content">运动前请先确认当前的身体状况。</string>
    <string name="guide_e_s8_title">低血糖预防</string>
    <string name="guide_e_s8_content">如感到手抖或出冷汗，请立即停止。</string>
    <string name="guide_e_s9_title">何时停止</string>
    <string name="guide_e_s9_content">身体不适时请勿强行坚持锻炼。</string>
    <string name="guide_e_remember">循序渐进，贵在坚持。</string>

    <string name="guide_h_intro">长期高血糖可能会损伤您的血管。</string>
    <string name="guide_h_s1_title">主要症状</string>
    <string name="guide_h_s1_content">需留意口渴、疲劳和尿频等信号。</string>
    <string name="guide_h_s2_title">常见原因</string>
    <string name="guide_h_s2_content">通常由于饮食不当或漏服药物引起。</string>
    <string name="guide_h_s3_title">确认步骤</string>
    <string name="guide_h_s3_content">请再次确保操作正确并重新测量。</string>
    <string name="guide_h_s4_title">紧急应对</string>
    <string name="guide_h_s4_content">多喝水并保持静养观察。</string>
    <string name="guide_h_s5_title">禁忌事项</string>
    <string name="guide_h_s5_content">切勿在未咨询医生的情况下增加药量。</string>
    <string name="guide_h_s6_title">运动须知</string>
    <string name="guide_h_s6_content">血糖过高时应避免剧烈运动。</string>
    <string name="guide_h_s7_title">紧急征兆</string>
    <string name="guide_h_s7_content">若出现神志不清请立即拨打急救。</string>
    <string name="guide_h_s8_title">就医标准</string>
    <string name="guide_h_s8_content">如果症状持续加重请即刻就医。</string>
    <string name="guide_h_warning">高血糖具有损害血管的长期风险。</string>
    <string name="guide_h_remember">了解波动的诱因是管理的第一步。</string>

    <string name="guide_l_intro">低血糖情况需要得到迅速处理。</string>
    <string name="guide_l_s1_title">初期症状</string>
    <string name="guide_l_s1_content">包括手抖、饥饿感和出冷汗等。</string>
    <string name="guide_l_s2_title">严重症状</string>
    <string name="guide_l_s2_content">可能导致意识模糊或神志不清。</string>
    <string name="guide_l_s3_title">常见原因</string>
    <string name="guide_l_s3_content">通常由空腹运动或用药过量引起。</string>
    <string name="guide_l_s4_title">15-15 原则</string>
    <string name="guide_l_s4_content">摄入 15g 糖分，等待 15 分钟再测。</string>
    <string name="guide_l_s5_title">不宜食品</string>
    <string name="guide_l_s5_content">巧克力等高脂食品吸收较慢。</string>
    <string name="guide_l_s6_title">紧急急救</string>
    <string name="guide_l_s6_content">无意识时切勿喂食，立即送医。</string>
    <string name="guide_l_s7_title">驾驶提示</string>
    <string name="guide_l_s7_content">如有不适应立即靠边停车处理。</string>
    <string name="guide_l_s8_title">运动后</string>
    <string name="guide_l_s8_content">运动后数小时仍需警惕低血糖。</string>
    <string name="guide_l_s9_title">预防方法</string>
    <string name="guide_l_s9_content">随身携带糖块等备用糖分。</string>
    <string name="guide_l_doctor">频繁发生时请务必咨询专业医生。</string>
    <string name="guide_l_remember">迅速补充糖分，分秒必争。</string>

    <string name="guide_f_intro">合理的平衡膳食是健康管理的核心。</string>
    <string name="guide_f_s1_title">碳水管理</string>
    <string name="guide_f_s1_content">推荐选择粗粮而非精制碳水化合物。</string>
    <string name="guide_f_s2_title">健康餐盘</string>
    <string name="guide_f_s2_content">蔬菜占一半，蛋白质与粗粮各 1/4。</string>
    <string name="guide_f_s3_title">进餐顺序</string>
    <string name="guide_f_s3_content">建议先吃蔬菜以减缓糖分吸收。</string>
    <string name="guide_f_s4_title">推荐食物</string>
    <string name="guide_f_s4_content">包括鱼类、豆腐和深色蔬菜等。</string>
    <string name="guide_f_s5_title">少食类</string>
    <string name="guide_f_s5_content">请减少含糖饮料和高糖甜点的摄入。</string>
    <string name="guide_f_s6_title">水果技巧</string>
    <string name="guide_f_s6_content">食用适量新鲜水果优于饮用果汁。</string>
    <string name="guide_f_s7_title">认识 GI 值</string>
    <string name="guide_f_s7_content">了解不同食物引起血糖上升的速度。</string>
    <string name="guide_f_s8_title">外餐技巧</string>
    <string name="guide_f_s8_content">尽量选择清淡烹饪而非油炸食品。</string>
    <string name="guide_f_s9_title">健康加餐</string>
    <string name="guide_f_s9_content">坚果或无糖酸奶是很好的选择。</string>
    <string name="guide_f_s10_title">饮水与酒</string>
    <string name="guide_f_s10_content">切勿空腹饮酒，多喝纯净水。</string>
    <string name="guide_f_s11_title">饮食记录</string>
    <string name="guide_f_s11_content">通过记录了解饮食对血糖的影响。</string>
    <string name="guide_f_remember">控制总量和比例是成功关键。</string>

