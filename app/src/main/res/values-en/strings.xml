    <!-- Guide Content -->
    <string name="guide_m_title">Glucose Management</string>
    <string name="guide_m_desc">Learn about measuring times, recording methods, and causes of fluctuations.</string>
    <string name="guide_m_keywords">Measure · Record · Patterns</string>
    <string name="guide_m_intro">Glucose management is about understanding how diet, exercise, and stress affect your body.</string>
    <string name="guide_m_s1_title">Why Record Glucose?</string>
    <string name="guide_m_s1_content">Recording helps you identify food impacts, exercise effects, and patterns for doctor visits.</string>
    <string name="guide_m_s2_title">When to Measure?</string>
    <string name="guide_m_s2_content">Measure fasting, 2h after meals, before/after exercise, and when feeling unwell.</string>
    <string name="guide_m_s3_title">Fasting vs Post-meal</string>
    <string name="guide_m_s3_content">Fasting shows baseline levels; post-meal shows response to food and carbs.</string>
    <string name="guide_m_s4_title">Accurate Measurement</string>
    <string name="guide_m_s4_content">Wash hands, dry completely, check strip expiration, and don\'t squeeze too hard.</string>
    <string name="guide_m_s5_title">Factors Affecting Glucose</string>
    <string name="guide_m_s5_content">Diet, exercise, stress, sleep, illness, medication, and alcohol all impact levels.</string>
    <string name="guide_m_s6_title">Checking Records</string>
    <string name="guide_m_s6_content">Look for patterns: persistent morning highs, meal spikes, or nighttime lows.</string>
    <string name="guide_m_remember">Patterns are more important than single numbers. Do not change doses without consulting a doctor.</string>
    <string name="guide_m_doctor">Consult if levels are consistently out of range or if you experience unexplained weight loss.</string>

    <string name="guide_e_title">Exercise Tips</string>
    <string name="guide_e_desc">Safe walking, strength training, and precautions.</string>
    <string name="guide_e_keywords">Aerobic · Strength · Safety</string>
    <string name="guide_e_intro">Exercise helps muscles use glucose and improves insulin sensitivity.</string>
    <string name="guide_e_s1_title">Benefits of Exercise</string>
    <string name="guide_e_s1_content">Reduces spikes, aids weight loss, improves heart health and sleep quality.</string>
    <string name="guide_e_s2_title">Walking</string>
    <string name="guide_e_s2_content">Perfect for beginners. Start slow and aim for 30 minutes after meals.</string>
    <string name="guide_e_s3_title">Cycling</string>
    <string name="guide_e_s3_content">Lower joint stress. Carry glucose tablets for outdoor rides.</string>
    <string name="guide_e_s4_title">Swimming</string>
    <string name="guide_e_s4_content">Full body workout. Inform staff or lifeguards of your condition for safety.</string>
    <string name="guide_e_s5_title">Strength Training</string>
    <string name="guide_e_s5_content">Maintains muscle mass. Try squats, elastic bands, or light weights.</string>
    <string name="guide_e_s6_title">Stretching</string>
    <string name="guide_e_s6_content">Maintains flexibility and prevents injury during workouts.</string>
    <string name="guide_e_s7_title">Check Before Exercise</string>
    <string name="guide_e_s7_content">Check glucose, carry sugar, stay hydrated, and check feet for blisters.</string>
    <string name="guide_e_s8_title">Hypoglycemia During Exercise</string>
    <string name="guide_e_s8_content">Sweating, shaking, or dizziness. Stop immediately and check glucose.</string>
    <string name="guide_e_s9_title">When to Skip Exercise</string>
    <string name="guide_e_s9_content">Skip if you have fever, vomiting, chest pain, or very high glucose levels.</string>
    <string name="guide_e_remember">Consistency over intensity. Always carry emergency glucose.</string>

    <string name="guide_h_title">Hyperglycemia</string>
    <string name="guide_h_desc">Symptoms, causes, and when to seek urgent care.</string>
    <string name="guide_h_keywords">Symptoms · Response · Urgent</string>
    <string name="guide_h_intro">High blood sugar occurs when glucose levels stay above your target range.</string>
    <string name="guide_h_s1_title">Core Symptoms</string>
    <string name="guide_h_s1_content">Extreme thirst, frequent urination, fatigue, and blurred vision.</string>
    <string name="guide_h_s2_title">Common Causes</string>
    <string name="guide_h_s2_content">Too many carbs, missed meds/insulin, stress, illness, or dehydration.</string>
    <string name="guide_h_s3_title">What to Check</string>
    <string name="guide_h_s3_content">Re-measure after washing hands, check meal timing, and look for signs of infection.</string>
    <string name="guide_h_s4_title">Immediate Actions</string>
    <string name="guide_h_s4_content">Drink water, follow your doctor\'s high-glucose plan, and rest.</string>
    <string name="guide_h_s5_title">What NOT to Do</string>
    <string name="guide_h_s5_content">Don\'t change insulin dose without a plan. Avoid intense exercise if levels are very high.</string>
    <string name="guide_h_s6_title">Hyperglycemia &amp; Exercise</string>
    <string name="guide_h_s6_content">Light activity is okay for some, but avoid it if you feel nauseous or have ketones.</string>
    <string name="guide_h_s7_title">Ketoacidosis Warnings</string>
    <string name="guide_h_s7_content">Vomiting, abdominal pain, fruity breath, or confusion. This is an emergency.</string>
    <string name="guide_h_s8_title">Seek Care Immediately</string>
    <string name="guide_h_s8_content">Persistent vomiting, severe dehydration, or confusion.</string>
    <string name="guide_h_remember">Record all factors to find the cause. Seek help if symptoms worsen.</string>

    <string name="guide_l_title">Hypoglycemia</string>
    <string name="guide_l_desc">15-15 rule and emergency response for low glucose.</string>
    <string name="guide_l_keywords">15-15 Rule · Prevention · SOS</string>
    <string name="guide_l_intro">Low blood sugar is generally defined as glucose below 70 mg/dL.</string>
    <string name="guide_l_s1_title">Early Symptoms</string>
    <string name="guide_l_s1_content">Sudden hunger, sweating, shaking, heart palpitations, and anxiety.</string>
    <string name="guide_l_s2_title">Severe Symptoms</string>
    <string name="guide_l_s2_content">Confusion, slurred speech, blurred vision, or loss of consciousness.</string>
    <string name="guide_l_s3_title">Common Causes</string>
    <string name="guide_l_s3_content">Missed meals, too much insulin, extra exercise, or alcohol on an empty stomach.</string>
    <string name="guide_l_s4_title">15-15 Rule</string>
    <string name="guide_l_s4_content">Eat 15g fast carbs, wait 15 min, re-measure. Repeat if still below 70.</string>
    <string name="guide_l_s5_title">Avoid These for Treatment</string>
    <string name="guide_l_s5_content">Chocolate, ice cream (fat slows sugar absorption), and diet/zero sodas.</string>
    <string name="guide_l_s6_title">If Unconscious</string>
    <string name="guide_l_s6_content">Do not give food. Call emergency services immediately.</string>
    <string name="guide_l_s7_title">Low While Driving</string>
    <string name="guide_l_s7_content">Stop safely, treat immediately. Don\'t drive until glucose is stable.</string>
    <string name="guide_l_s8_title">Exercise Lows</string>
    <string name="guide_l_s8_content">Can happen hours after workout. Consult your doctor about adjusting meds.</string>
    <string name="guide_l_s9_title">Prevention</string>
    <string name="guide_l_s9_content">Don\'t skip meals, carry sugar, and inform family about your symptoms.</string>
    <string name="guide_l_remember">Low glucose is an emergency. Act fast, don\'t wait.</string>
    <string name="guide_l_doctor">Consult if lows repeat weekly or during sleep.</string>

    <string name="guide_f_title">Food Guide</string>
    <string name="guide_f_desc">Balanced plate, eating order, and smart snack choices.</string>
    <string name="guide_f_keywords">Diet · Carbs · GI Index</string>
    <string name="guide_f_intro">Healthy eating is about balance, portions, and consistency.</string>
    <string name="guide_f_s1_title">Glucose &amp; Carbs</string>
    <string name="guide_f_s1_content">Carbs impact glucose most. Choose fiber-rich whole grains over refined carbs.</string>
    <string name="guide_f_s2_title">The Plate Model</string>
    <string name="guide_f_s2_content">1/2 Veggies, 1/4 Protein, 1/4 Whole Grains.</string>
    <string name="guide_f_s3_title">Eating Order</string>
    <string name="guide_f_s3_content">Fiber first, then protein, then carbs to slow sugar absorption.</string>
    <string name="guide_f_s4_title">Recommended Foods</string>
    <string name="guide_f_s4_content">Broccoli, fish, tofu, nuts, and whole grains.</string>
    <string name="guide_f_s5_title">Reduce These Foods</string>
    <string name="guide_f_s5_content">Sugary drinks, white bread, processed meats, and excessive alcohol.</string>
    <string name="guide_f_s11_title">Meal Records</string>
    <string name="guide_f_s11_content">Track time, food, and portions to find your perfect diet.</string>
    <string name="guide_f_remember">Even healthy food can raise glucose if eaten in excess.</string>

    <string name="guide_label_remember">Remember</string>
    <string name="guide_source_full">Ref: ADA, ADA 2026.</string>

